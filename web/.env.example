# Public API URL (what the browser and embedded snippet will see)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Internal URL the Next.js server uses to talk to the API.
# Overridden to http://api:3001 in docker compose.
API_URL=http://localhost:3001

# Credentials for the /admin panel. Must match the API's.
# Used only on the Next.js server; never reaches the browser.
ADMIN_USER=owner
ADMIN_PASSWORD=change-this-long-password
