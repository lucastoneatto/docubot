# PostgreSQL (pgvector). Start with: docker compose up -d db
DATABASE_URL=postgres://docubot:docubot@localhost:5432/docubot

# Auth
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Chat (OpenAI-compatible). Change CHAT_BASE_URL for DeepSeek/Groq/Together
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
CHAT_BASE_URL=https://api.openai.com/v1
# Relative cutoff to the best result in retrieval (see keepRelevant).
CHAT_RELATIVE_MARGIN=0.02

# Embeddings: "local" (e5-small on CPU, free) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# API
API_PORT=3001
API_URL=http://localhost:3001
# If true, /chat does not validate Origin (development only)
CORS_RELAXED=false

# Ingestion
# Days conversations are kept (0 = forever).
CONVERSATION_RETENTION_DAYS=180
INGEST_MAX_FILES=200
INGEST_MAX_FILE_SIZE_MB=100
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP=150

# Origins the dashboard is always allowed to use /chat from
DASHBOARD_ORIGINS=http://localhost:3000

# Prices per 1M tokens (for AI spend accounting).
# gpt-4o-mini: $0.15 input / $0.60 output · text-embedding-3-small: $0.02
PRICE_CHAT_INPUT_PER_M=0.15
PRICE_CHAT_OUTPUT_PER_M=0.60
PRICE_EMBEDDING_PER_M=0.02

# Admin seed (optional)
SEED_ADMIN_EMAIL=admin@docubot.local
SEED_ADMIN_PASSWORD=password1234

# --- Operator panel (/admin) ---
# Basic auth for the platform owner's panel.
# Required in production: the API won't boot without this (12+ char password).
ADMIN_USER=owner
ADMIN_PASSWORD=change-this-long-password

# --- Ingestion queue (BullMQ + Dragonfly) ---
# Dragonfly speaks the Redis protocol; start with: docker compose up -d dragonfly
REDIS_URL=redis://localhost:6379
# Number of files processed in parallel by the worker, GLOBAL across all
# collections (each uploaded file is its own BullMQ job).
INGEST_FILE_CONCURRENCY=4

# --- Queue dashboard (/admin/queues) ---
# Own basic auth; falls back to ADMIN_USER/ADMIN_PASSWORD if omitted.
# Required in production: the API won't boot without this (12+ char password).
BULL_BOARD_USER=owner
BULL_BOARD_PASSWORD=change-this-long-password
